---
// Minrock's top bar: brand, centred nav, and two controls (theme, language).
// The thin scroll-progress line on the bottom edge is Scholar's.
import LanguageSwitch from './LanguageSwitch.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { person } from '../data/cv';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sections = ['experience', 'projects', 'education', 'skills', 'contact'] as const;
---

<header class="site-header" id="site-header">
  <div class="container-wide header-inner">
    <a href="#top" class="brand" aria-label={`${person.name}, ${t('home')}`}>
      <Logo class="brand-logo" />
      <span class="brand-title">{person.name}</span>
    </a>

    <nav class="nav" aria-label={t('nav.label')}>
      {
        sections.map((id) => (
          <a href={`#${id}`} class="nav-link" data-nav={id}>
            {t(`section.${id}`)}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle lang={lang} />
      <LanguageSwitch lang={lang} />
    </div>
  </div>

  <div class="header-progress" aria-hidden="true">
    <span data-scroll-progress></span>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand :global(.brand-logo) {
    flex-shrink: 0;
    width: auto;
    height: 1.6rem;
  }

  /* Hovering the name makes the logo's star grow and make a quarter turn. */
  .brand:is(:hover, :focus-visible) :global(.logo-star) {
    transform: rotate(90deg) scale(1.35);
  }

  .brand-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
  }

  /* Scholar marks the current page with a dot; here it tracks the section in view. */
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -0.15rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--star);
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
  }

  .header-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .header-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform-origin: left center;
    scale: 0 1;
  }

  /* Breakpoints come from measured widths (brand with logo 268px, nav 455px
     EN / 525px IT, controls about 110px). */
  @media (max-width: 1100px) {
    .header-inner {
      gap: 1.25rem;
    }

    .nav {
      gap: 1.1rem;
    }
  }

  /* Below this the Italian row no longer fits: the nav drops to its own row
     and scrolls sideways instead of clipping. */
  @media (max-width: 979px) {
    .site-header {
      padding: 0.65rem 0 0.25rem;
    }

    /* Name and controls share the first row; the name column can shrink
       (at worst it ellipsizes) so the controls never drop to a third row. */
    .header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'brand actions'
        'nav nav';
      row-gap: 0.3rem;
    }

    .brand {
      grid-area: brand;
      justify-self: start;
      max-width: 100%;
    }

    .header-actions {
      grid-area: actions;
    }

    .nav {
      grid-area: nav;
      width: calc(100% + 3rem);
      margin-inline: -1.5rem;
      padding: 0 1.5rem 0.3rem;
      gap: 0.35rem;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    /* Auto margins centre the row when it fits and keep it scrollable when not. */
    .nav-link:first-child {
      margin-left: auto;
    }

    .nav-link:last-child {
      margin-right: auto;
    }

    .nav-link {
      padding: 0.3rem 0.55rem;
    }

    .nav-link.is-active::after {
      bottom: 0;
    }

    /* The scroller clips anything outside it, so draw focus rings inside. */
    .nav-link:focus-visible {
      outline-offset: -2px;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      column-gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .nav {
      width: calc(100% + 2rem);
      margin-inline: -1rem;
      padding-inline: 1rem;
      gap: 0;
    }

    .nav-link {
      padding: 0.3rem 0.4rem;
      font-size: 0.9rem;
    }

    .brand {
      gap: 0.4rem;
      font-size: 1.05rem;
    }

    .brand :global(.brand-logo) {
      height: 1.45rem;
    }

    .header-actions {
      gap: 0.3rem;
    }
  }

  @media (max-width: 400px) {
    .header-actions {
      --control: 36px;
    }

    .brand {
      font-size: 1rem;
    }

    .brand :global(.brand-logo) {
      height: 1.3rem;
    }
  }

  @media (max-width: 370px) {
    .brand {
      font-size: 0.92rem;
    }

    .brand :global(.brand-logo) {
      height: 1.2rem;
    }
  }
</style>

<script>
  // ── Header height, scroll progress, and the section in view ──
  const root = document.documentElement;
  const header = document.getElementById('site-header')!;
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const nav = header.querySelector<HTMLElement>('.nav')!;
  const navLinks = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = navLinks.map((link) => document.getElementById(link.dataset.nav!)).filter((el) => el !== null);

  new ResizeObserver(() => root.style.setProperty('--header-height', `${header.offsetHeight}px`)).observe(header);

  let activeId: string | null = null;
  let frame = 0;

  function update() {
    frame = 0;
    const { scrollHeight, clientHeight } = root;
    const range = scrollHeight - clientHeight;
    if (progress) progress.style.scale = `${range > 0 ? Math.min(1, Math.max(0, scrollY / range)) : 0} 1`;

    // The last section whose top has passed a line a third of the way down.
    const line = header.offsetHeight + (clientHeight - header.offsetHeight) / 3;
    let id: string | null = null;
    for (const section of sections) if (section.getBoundingClientRect().top <= line) id = section.id;
    if (range > 0 && scrollY >= range - 2) id = sections.at(-1)?.id ?? id;
    if (id === activeId) return;
    activeId = id;

    for (const link of navLinks) {
      const on = link.dataset.nav === id;
      link.classList.toggle('is-active', on);
      if (on) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
      // On narrow screens the nav scrolls sideways; keep the active link visible.
      if (on && nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({ left: link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2, behavior: 'smooth' });
      }
    }
  }

  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule, { passive: true });
  update();
</script>
