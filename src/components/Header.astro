---
// Minrock's top bar: brand, centred nav, and two controls (theme, language).
// The thin scroll-progress line on the bottom edge is Scholar's.
import LanguageSwitch from './LanguageSwitch.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { person } from '../data/cv';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sections = ['experience', 'projects', 'education', 'skills', 'contact'] as const;
---

<header class="site-header" id="site-header" data-brand-label={`${person.name}, ${t('home')}`}>
  <div class="container-wide header-inner">
    <!-- Persisted across page swaps (e.g. a language switch), so its open or
         folded state carries over instead of replaying the page-load reveal. -->
    <a href="#top" class="brand is-open" aria-label={`${person.name}, ${t('home')}`} transition:persist="brand">
      <Logo class="brand-logo" />
      <span class="brand-title">{person.name}</span>
    </a>

    <nav class="nav" aria-label={t('nav.label')}>
      {
        sections.map((id) => (
          <a href={`#${id}`} class="nav-link" data-nav={id}>
            {t(`section.${id}`)}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle lang={lang} />
      <LanguageSwitch lang={lang} />
    </div>
  </div>

  <div class="header-progress" aria-hidden="true">
    <span data-scroll-progress></span>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* The name always keeps its space (nothing else in the bar moves); the logo
     sits in the padding to its left, positioned absolutely so it can glide. */
  .brand {
    --logo-h: 1.6rem;
    --brand-gap: 0.5rem;
    --brand-pad: calc(var(--logo-h) * 1145 / 817 + var(--brand-gap));
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    padding-left: var(--brand-pad);
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand :global(.brand-logo) {
    position: absolute;
    top: 50%;
    left: 0;
    width: auto;
    height: var(--logo-h);
    translate: 0 -50%;
  }

  .brand-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* With a mouse the brand folds into the logo, centred in the name's space.
     Open (page load, hover, focus): the logo glides left, the letters fade,
     the star turns and grows to fill the logo's box, and the name opens out
     from under where the logo sat. Touch screens keep logo and name visible. */
  @media (hover: hover) {
    .brand :global(.brand-logo) {
      left: 50%;
      translate: -50% -50%;
      transition:
        left 460ms var(--ease) 60ms,
        translate 460ms var(--ease) 60ms;
    }

    .brand :global(.logo-letters) {
      transition:
        opacity 220ms ease 200ms,
        transform 320ms var(--ease) 150ms;
    }

    .brand :global(.logo-star) {
      transition: transform 480ms cubic-bezier(0.34, 1.36, 0.64, 1);
    }

    /* the reveal starts as a line right under the resting logo */
    .brand-title {
      clip-path: inset(0 calc(50% + var(--brand-pad) / 2) 0 calc(50% - var(--brand-pad) / 2));
      opacity: 0;
      transition:
        clip-path 320ms var(--ease),
        opacity 200ms ease;
    }

    .brand:is(:hover, :focus-visible, .is-open) :global(.brand-logo) {
      left: 0;
      translate: 0 -50%;
      transition-delay: 0s;
    }

    .brand:is(:hover, :focus-visible, .is-open) :global(.logo-letters) {
      opacity: 0;
      transform: scale(0.82);
      transition-delay: 0s;
    }

    /* arm crossing to the centre of the logo box, a quarter turn, full height */
    .brand:is(:hover, :focus-visible, .is-open) :global(.logo-star) {
      transform: translate(20.3px, 162px) rotate(90deg) scale(1.9);
    }

    .brand:is(:hover, :focus-visible, .is-open) .brand-title {
      clip-path: inset(0);
      opacity: 1;
      transition:
        clip-path 480ms var(--ease) 40ms,
        opacity 240ms ease 40ms;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
  }

  /* Scholar marks the current page with a dot; here it tracks the section in view. */
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -0.15rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--star);
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
  }

  .header-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .header-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform-origin: left center;
    scale: 0 1;
  }

  /* Breakpoints come from measured widths (brand with logo 268px, nav 455px
     EN / 525px IT, controls about 110px). */
  @media (max-width: 1100px) {
    .header-inner {
      gap: 1.25rem;
    }

    .nav {
      gap: 1.1rem;
    }
  }

  /* Below this the Italian row no longer fits: the nav drops to its own row
     and scrolls sideways instead of clipping. */
  @media (max-width: 979px) {
    .site-header {
      padding: 0.65rem 0 0.25rem;
    }

    /* Name and controls share the first row; the name column can shrink
       (at worst it ellipsizes) so the controls never drop to a third row. */
    .header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'brand actions'
        'nav nav';
      row-gap: 0.3rem;
    }

    .brand {
      grid-area: brand;
      justify-self: start;
      max-width: 100%;
    }

    .header-actions {
      grid-area: actions;
    }

    .nav {
      grid-area: nav;
      width: calc(100% + 3rem);
      margin-inline: -1.5rem;
      padding: 0 1.5rem 0.3rem;
      gap: 0.35rem;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    /* Auto margins centre the row when it fits and keep it scrollable when not. */
    .nav-link:first-child {
      margin-left: auto;
    }

    .nav-link:last-child {
      margin-right: auto;
    }

    .nav-link {
      padding: 0.3rem 0.55rem;
    }

    .nav-link.is-active::after {
      bottom: 0;
    }

    /* The scroller clips anything outside it, so draw focus rings inside. */
    .nav-link:focus-visible {
      outline-offset: -2px;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      column-gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .nav {
      width: calc(100% + 2rem);
      margin-inline: -1rem;
      padding-inline: 1rem;
      gap: 0;
    }

    .nav-link {
      padding: 0.3rem 0.4rem;
      font-size: 0.9rem;
    }

    .brand {
      --logo-h: 1.45rem;
      --brand-gap: 0.4rem;
      font-size: 1.05rem;
    }

    .header-actions {
      gap: 0.3rem;
    }
  }

  @media (max-width: 400px) {
    .header-actions {
      --control: 36px;
    }

    .brand {
      --logo-h: 1.3rem;
      font-size: 1rem;
    }
  }

  @media (max-width: 370px) {
    .brand {
      --logo-h: 1.2rem;
      font-size: 0.92rem;
    }
  }
</style>

<script>
  const root = document.documentElement;

  // ── Brand: open at the first page load, then fold into the logo; hover
  // reopens it. Only where a mouse can bring it back and motion is welcome.
  // The brand element survives page swaps, so this runs once per visit.
  if (matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setTimeout(() => document.querySelector('.brand')?.classList.remove('is-open'), 1600);
  }

  // ── Header height, scroll progress, and the section in view. The header
  // is swapped with each page, so these are re-bound on every page load.
  let header: HTMLElement;
  let progress: HTMLElement | null;
  let nav: HTMLElement;
  let navLinks: HTMLAnchorElement[] = [];
  let sections: HTMLElement[] = [];
  let activeId: string | null = null;
  let frame = 0;
  const heightObserver = new ResizeObserver(() => root.style.setProperty('--header-height', `${header.offsetHeight}px`));

  function update() {
    frame = 0;
    if (!header) return;
    const { scrollHeight, clientHeight } = root;
    const range = scrollHeight - clientHeight;
    if (progress) progress.style.scale = `${range > 0 ? Math.min(1, Math.max(0, scrollY / range)) : 0} 1`;

    // The last section whose top has passed a line a third of the way down.
    const line = header.offsetHeight + (clientHeight - header.offsetHeight) / 3;
    let id: string | null = null;
    for (const section of sections) if (section.getBoundingClientRect().top <= line) id = section.id;
    if (range > 0 && scrollY >= range - 2) id = sections.at(-1)?.id ?? id;
    if (id === activeId) return;
    activeId = id;

    for (const link of navLinks) {
      const on = link.dataset.nav === id;
      link.classList.toggle('is-active', on);
      if (on) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
      // On narrow screens the nav scrolls sideways; keep the active link visible.
      if (on && nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({ left: link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2, behavior: 'smooth' });
      }
    }
  }

  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule, { passive: true });

  document.addEventListener('astro:page-load', () => {
    header = document.getElementById('site-header')!;
    progress = header.querySelector<HTMLElement>('[data-scroll-progress]');
    nav = header.querySelector<HTMLElement>('.nav')!;
    navLinks = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    sections = navLinks.map((link) => document.getElementById(link.dataset.nav!)).filter((el) => el !== null);
    activeId = null;
    // The persisted brand keeps the label of the page it came from.
    header.querySelector('.brand')?.setAttribute('aria-label', header.dataset.brandLabel!);
    heightObserver.disconnect();
    heightObserver.observe(header);
    update();
  });

  // The swap replaces <html>'s attributes; carry the header height over so
  // anchor offsets stay right until the observer measures the new header.
  document.addEventListener('astro:before-swap', (event) => {
    const height = root.style.getPropertyValue('--header-height');
    if (height) event.newDocument.documentElement.style.setProperty('--header-height', height);
  });
</script>
