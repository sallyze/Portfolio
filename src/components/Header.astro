---
// Minrock's top bar: brand, centred nav, and a control cluster. Minrock's
// search box becomes the CV download (same shape, same "kbd" tag). The thin
// scroll-progress line on the bottom edge is Scholar's.
import Icon from './Icon.astro';
import LanguageMenu from './LanguageMenu.astro';
import SocialMenu from './SocialMenu.astro';
import ThemeMenu from './ThemeMenu.astro';
import { person } from '../data/cv';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sections = ['experience', 'projects', 'education', 'skills', 'contact'] as const;
---

<header class="site-header" id="site-header">
  <div class="container-wide header-inner">
    <a href="#top" class="brand" aria-label={`${person.name}, ${t('home')}`}>
      <span class="brand-star" aria-hidden="true"></span>
      <span class="brand-title">{person.name}</span>
    </a>

    <nav class="nav" aria-label={t('nav.label')}>
      {
        sections.map((id) => (
          <a href={`#${id}`} class="nav-link" data-nav={id}>
            {t(`section.${id}`)}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        href={person.cvFile}
        download
        class="cv-trigger"
        aria-label={`${t('cv.download')} (PDF)`}
        title={t('cv.format')}
      >
        <span class="cv-trigger-inner">
          <Icon name="download" size={14} />
          <span class="cv-trigger-text">{t('cv.download')}</span>
        </span>
        <span class="cv-trigger-tag" aria-hidden="true">PDF</span>
      </a>

      <div class="header-controls">
        <SocialMenu lang={lang} />
        <ThemeMenu lang={lang} />
        <LanguageMenu lang={lang} />
      </div>
    </div>
  </div>

  <div class="header-progress" aria-hidden="true">
    <span data-scroll-progress></span>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand:hover {
    color: var(--text);
  }

  /* Scholar's four-point star, the mark that repeats on every section heading. */
  .brand-star {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    background: var(--primary);
    clip-path: var(--star-shape);
    transition: transform 260ms var(--ease);
  }

  .brand:hover .brand-star {
    transform: rotate(25deg) scale(1.1);
  }

  .brand-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
  }

  /* Scholar marks the current page with a dot; here it tracks the section in view. */
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -0.15rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--star);
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.85rem;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cv-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: var(--control);
    padding: 0 0.45rem 0 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .cv-trigger:hover {
    border-color: var(--accent);
    background-color: var(--bg-subtle);
    color: var(--text);
  }

  .cv-trigger-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cv-trigger-tag {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background-color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.3;
  }

  .header-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .header-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform-origin: left center;
    scale: 0 1;
  }

  /* Breakpoints come from measured widths (brand 248px, nav 455px EN / 525px
     IT, controls 302px): below 1180px the Italian row no longer fits, and
     below 1010px not even with the icon-only download button. */

  /* Minrock swaps its search box for an icon button on narrower screens. */
  @media (max-width: 1180px) {
    .header-inner {
      gap: 1.25rem;
    }

    .nav {
      gap: 1.1rem;
    }

    .cv-trigger {
      justify-content: center;
      width: var(--control);
      padding: 0;
    }

    .cv-trigger-text,
    .cv-trigger-tag {
      display: none;
    }
  }

  /* The nav drops to its own row and scrolls sideways instead of clipping. */
  @media (max-width: 1010px) {
    .site-header {
      padding: 0.65rem 0 0.25rem;
    }

    .header-inner {
      flex-wrap: wrap;
      row-gap: 0.3rem;
    }

    .header-actions {
      gap: 0.4rem;
    }

    .nav {
      order: 3;
      width: calc(100% + 3rem);
      margin-inline: -1.5rem;
      padding: 0 1.5rem 0.3rem;
      gap: 0.35rem;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    /* Auto margins centre the row when it fits and keep it scrollable when not. */
    .nav-link:first-child {
      margin-left: auto;
    }

    .nav-link:last-child {
      margin-right: auto;
    }

    .nav-link {
      padding: 0.3rem 0.55rem;
    }

    .nav-link.is-active::after {
      bottom: 0;
    }

    /* The scroller clips anything outside it, so draw focus rings inside. */
    .nav-link:focus-visible {
      outline-offset: -2px;
    }
  }

  /* The profile's own download button sits just below on phones. */
  @media (max-width: 640px) {
    .cv-trigger {
      display: none;
    }

    .header-inner {
      column-gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .nav {
      width: calc(100% + 2rem);
      margin-inline: -1rem;
      padding-inline: 1rem;
      gap: 0;
    }

    .nav-link {
      padding: 0.3rem 0.4rem;
      font-size: 0.9rem;
    }

    .brand {
      gap: 0.4rem;
      font-size: 1.05rem;
    }

    .brand-star {
      width: 0.9rem;
      height: 0.9rem;
    }

    .header-controls {
      gap: 0.3rem;
    }
  }

  @media (max-width: 400px) {
    .header-controls {
      --control: 36px;
    }
  }

  @media (max-width: 370px) {
    .brand {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  // ── Dropdown menus (shared by the connect, theme and language menus) ──
  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];

  function setOpen(menu: HTMLElement, open: boolean) {
    const trigger = menu.querySelector<HTMLButtonElement>('[data-menu-trigger]')!;
    const panel = menu.querySelector<HTMLElement>('[data-menu-panel]')!;
    trigger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    panel.style.transform = '';
    if (!open) return;
    // Keep the panel inside the viewport on narrow screens.
    const rect = panel.getBoundingClientRect();
    const pad = 12;
    if (rect.left < pad) panel.style.transform = `translateX(${pad - rect.left}px)`;
    else if (rect.right > window.innerWidth - pad)
      panel.style.transform = `translateX(${window.innerWidth - pad - rect.right}px)`;
  }

  const isOpen = (menu: HTMLElement) =>
    menu.querySelector('[data-menu-trigger]')?.getAttribute('aria-expanded') === 'true';

  for (const menu of menus) {
    const trigger = menu.querySelector<HTMLButtonElement>('[data-menu-trigger]')!;

    trigger.addEventListener('click', () => {
      const open = !isOpen(menu);
      menus.forEach((other) => other !== menu && setOpen(other, false));
      setOpen(menu, open);
    });

    menu.addEventListener('keydown', (event) => {
      if (!isOpen(menu)) return;
      if (event.key === 'Escape') {
        setOpen(menu, false);
        trigger.focus();
        return;
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const items = [...menu.querySelectorAll<HTMLElement>('[data-menu-item]')];
      const current = items.indexOf(document.activeElement as HTMLElement);
      const step = event.key === 'ArrowDown' ? 1 : -1;
      const next = current === -1 ? (step === 1 ? 0 : items.length - 1) : (current + step + items.length) % items.length;
      items[next]?.focus();
    });

    // Tabbing away closes the menu, as clicking elsewhere does.
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node | null)) setOpen(menu, false);
    });
  }

  document.addEventListener('click', (event) => {
    for (const menu of menus) if (!menu.contains(event.target as Node)) setOpen(menu, false);
  });

  // ── Theme ──
  const root = document.documentElement;
  const themeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-value]')];

  const themeTrigger = document.querySelector<HTMLElement>('[data-theme-trigger]');

  function showTheme(pref: string) {
    themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeValue === pref)));
    const name = themeButtons.find((button) => button.dataset.themeValue === pref)?.querySelector('.theme-name')?.textContent;
    if (themeTrigger && name) themeTrigger.setAttribute('aria-label', `${themeTrigger.dataset.label}: ${name}`);
  }

  showTheme(root.dataset.themePref ?? 'auto');

  for (const button of themeButtons) {
    button.addEventListener('click', () => {
      const pref = button.dataset.themeValue!;
      // "auto" drops the attribute so light-dark() follows the OS live.
      if (pref === 'auto') delete root.dataset.theme;
      else root.dataset.theme = pref;
      root.dataset.themePref = pref;
      try {
        localStorage.setItem('theme', pref);
      } catch {
        /* storage blocked: the choice lasts for this page view */
      }
      showTheme(pref);
    });
  }

  // ── Language: land on the same section in the other language ──
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]')) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (link.hasAttribute('aria-current')) {
        menus.forEach((menu) => setOpen(menu, false));
        return;
      }
      const active = document.querySelector<HTMLAnchorElement>('.nav-link.is-active');
      window.location.href = link.getAttribute('href')! + (active?.hash ?? '');
    });
  }

  // ── Header height, scroll progress, and the section in view ──
  const header = document.getElementById('site-header')!;
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const nav = header.querySelector<HTMLElement>('.nav')!;
  const navLinks = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = navLinks.map((link) => document.getElementById(link.dataset.nav!)).filter((el) => el !== null);

  new ResizeObserver(() => root.style.setProperty('--header-height', `${header.offsetHeight}px`)).observe(header);

  let activeId: string | null = null;
  let frame = 0;

  function update() {
    frame = 0;
    const { scrollHeight, clientHeight } = root;
    const range = scrollHeight - clientHeight;
    if (progress) progress.style.scale = `${range > 0 ? Math.min(1, Math.max(0, scrollY / range)) : 0} 1`;

    // The last section whose top has passed a line a third of the way down.
    const line = header.offsetHeight + (clientHeight - header.offsetHeight) / 3;
    let id: string | null = null;
    for (const section of sections) if (section.getBoundingClientRect().top <= line) id = section.id;
    if (range > 0 && scrollY >= range - 2) id = sections.at(-1)?.id ?? id;
    if (id === activeId) return;
    activeId = id;

    for (const link of navLinks) {
      const on = link.dataset.nav === id;
      link.classList.toggle('is-active', on);
      if (on) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
      // On narrow screens the nav scrolls sideways; keep the active link visible.
      if (on && nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({ left: link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2, behavior: 'smooth' });
      }
    }
  }

  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule, { passive: true });
  update();
</script>
