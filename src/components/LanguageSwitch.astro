---
// Two-flag language switch. The whole control is one link to the other
// language: the thumb slides onto its flag, then the client router swaps the
// page in place (no reload), keeping the reader where they were.
import { homePath, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'it' : 'en';
---

<a
  class="lang-switch"
  href={homePath[other]}
  hreflang={other}
  lang={other}
  aria-label={languages[other]}
  title={languages[other]}
  data-active={lang}
  data-lang-switch
  data-astro-prefetch
>
  <span class="lang-thumb" aria-hidden="true"></span>
  <span class="lang-flag" data-code="en" aria-hidden="true">
    <svg width="20" height="14" viewBox="0 0 60 42">
      <rect width="60" height="42" fill="#012169" />
      <path d="M0 0 60 42M60 0 0 42" stroke="#fff" stroke-width="8" />
      <path d="M0 0 60 42M60 0 0 42" stroke="#c8102e" stroke-width="2.6" />
      <path d="M30 0v42M0 21h60" stroke="#fff" stroke-width="13" />
      <path d="M30 0v42M0 21h60" stroke="#c8102e" stroke-width="7.8" />
    </svg>
  </span>
  <span class="lang-flag" data-code="it" aria-hidden="true">
    <svg width="20" height="14" viewBox="0 0 3 2" preserveAspectRatio="none">
      <rect width="1" height="2" fill="#009246" />
      <rect x="1" width="1" height="2" fill="#ffffff" />
      <rect x="2" width="1" height="2" fill="#ce2b37" />
    </svg>
  </span>
</a>

<style>
  /* Same rounded square as the theme button, two cells wide. */
  .lang-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--control);
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .lang-switch:hover {
    border-color: var(--accent);
    background-color: var(--bg-subtle);
  }

  .lang-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: 30px;
    border-radius: 4px;
    background-color: var(--bg);
    box-shadow:
      0 0 0 1px var(--border),
      0 1px 2px rgb(0 0 0 / 0.16);
    transition: transform 180ms var(--ease);
  }

  .lang-switch[data-active='it'] .lang-thumb {
    transform: translateX(30px);
  }

  .lang-flag {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 100%;
    opacity: 0.5;
    filter: saturate(0.5);
    transition:
      opacity 0.15s ease,
      filter 0.15s ease;
  }

  .lang-switch[data-active='en'] [data-code='en'],
  .lang-switch[data-active='it'] [data-code='it'] {
    opacity: 1;
    filter: none;
  }

  .lang-switch:hover .lang-flag {
    opacity: 1;
  }

  .lang-flag svg {
    display: block;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.18);
  }
</style>

<script>
  // The client router handles the click itself (plain clicks only; modifier
  // clicks still open a new tab). This hooks its events to keep the reader's
  // place: the section in view and how far from the top of the window it sat.
  let anchor: { id: string; top: number } | null = null;

  document.addEventListener('astro:before-preparation', (event) => {
    const link = (event.sourceElement as Element | undefined)?.closest<HTMLAnchorElement>('[data-lang-switch]');
    if (!link) return;
    const section = document.querySelector<HTMLAnchorElement>('.nav-link.is-active')?.hash.slice(1);
    const el = section ? document.getElementById(section) : null;
    anchor = el ? { id: el.id, top: el.getBoundingClientRect().top } : null;
    link.dataset.active = link.hreflang; // slide the thumb to the new language
    // Load the page while the thumb slides; swap once both are done.
    const load = event.loader;
    const slide = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 180;
    event.loader = () => Promise.all([load(), new Promise((r) => setTimeout(r, slide))]).then(() => {});
  });

  // Runs right after the swap, before the new page is shown.
  document.addEventListener('astro:after-swap', () => {
    const el = anchor && document.getElementById(anchor.id);
    if (el) scrollTo({ top: scrollY + el.getBoundingClientRect().top - anchor!.top, behavior: 'instant' });
    anchor = null;
  });
</script>
