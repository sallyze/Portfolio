---
// SM monogram, traced from the design in cv/ (S and M joined through the star).
// Inline so the letters take the palette's text colour and the star can turn.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['logo', className]} viewBox="0 0 1145 817" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M24 673.9C42 692.9 60.9 710.6 82.1 726C145.1 771.8 222.8 793.2 300.1 793.4C322.5 793.4 345.2 792.8 367.4 789.3C462.2 774.5 548.5 723 566.3 621.8C570.2 599.3 569.8 576 567 553.5C564.9 537.3 560.8 521.3 554.8 506.2C526.6 435 463.1 401.5 394.9 377.1C375.3 370.1 355.5 363.5 335.6 357.6C295.5 345.7 239.8 327.6 209.4 298.2C196.7 285.9 187.4 270.3 183.7 252.8C181 240.2 181.3 227.2 183.8 214.6C192.3 171.9 226.1 147.2 266.7 138C318.5 126.4 376.3 135.3 423.3 159.4C437.3 166.5 449.8 175.3 462.4 184.6L497.3 81.1C476.1 67.8 454.6 56.8 430.7 48.9C405.7 40.5 379.5 34.5 353.3 31.6C245.2 19.8 112.9 54.1 70.6 166C63.4 185.2 59.2 206 58.6 226.6C57.9 252.2 59.4 277.5 66.5 302.3C94.1 399.9 200 432.9 285.7 461.2C338.2 478.6 420.1 499.9 440.3 558.2C443.4 567 444.8 576.3 445.1 585.7C447 645.9 392.2 678.9 338.2 684.2C276.1 690.4 216.7 680.3 163.4 646.3C137 629.5 114.8 608.5 94 585.4ZM1121.4 38.4L1121.4 785.2L1005.3 785.2L1005.3 258.7L815 647.3L722.6 647.3L603.2 414.5L625.4 341.4C626.1 339.2 646.6 328.1 649.3 327.2L672.3 319L768.1 509.1L976.1 82.1C985 63.9 1011.7 38.4 1031.2 38.4L1121.4 38.4Z" />
  <path class="logo-star" d="M552.2 24C616.1 238.3 548.7 185.6 769.5 246.5C577.4 311.9 615.9 231.6 552.2 442.3C488.6 231.6 527 311.9 334.9 246.5C555.7 185.6 488.3 238.3 552.2 24Z" />
</svg>

<style>
  .logo-star {
    fill: var(--logo-star);
    /* Turn about the point where the arms cross, not the box centre:
       the top arm is longer than the bottom one. */
    transform-box: fill-box;
    transform-origin: 50% 53.2%;
    /* slight overshoot, so the turn lands with a small pop */
    transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* the grown star reaches past the letters' box */
  .logo {
    overflow: visible;
  }
</style>
