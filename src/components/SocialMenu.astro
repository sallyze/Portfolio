---
// Minrock's "Connect" dropdown, listing every contact channel from the CV.
import Icon from './Icon.astro';
import { contacts, type Contact } from '../data/cv';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const order: Contact['id'][] = ['linkedin', 'github', 'email', 'phone', 'website'];
const items = order.map((id) => contacts.find((contact) => contact.id === id)!);
---

<div class="menu" data-menu>
  <button
    type="button"
    class="menu-trigger"
    aria-expanded="false"
    aria-controls="menu-connect"
    aria-label={t('menu.connect.label')}
    title={t('menu.connect.label')}
    data-menu-trigger
  >
    <Icon name="at-sign" size={15} />
    <Icon name="chevron-down" size={9} strokeWidth={2.5} class="menu-chevron" />
  </button>

  <div class="menu-panel" id="menu-connect" data-menu-panel hidden>
    <p class="menu-heading" id="menu-connect-heading">{t('menu.connect')}</p>
    <ul class="connect-list" aria-labelledby="menu-connect-heading">
      {
        items.map((contact) => {
          const external = contact.href.startsWith('http');
          return (
            <li>
              <a
                class="menu-item connect-item"
                href={contact.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer me' : undefined}
                data-menu-item
              >
                <span class:list={['connect-icon', { 'is-linkedin': contact.id === 'linkedin' }]}>
                  <Icon name={contact.icon} size={15} />
                </span>
                <span class="connect-info">
                  <span class="connect-name">{t(contact.label)}</span>
                  <span class="connect-handle">{contact.display}</span>
                </span>
                {external && <span class="sr-only">{t('newTab')}</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<style>
  .connect-list {
    padding: 0;
    list-style: none;
  }

  .connect-item {
    gap: 0.65rem;
  }

  .connect-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    transition:
      color 0.12s ease,
      border-color 0.12s ease;
  }

  .connect-icon.is-linkedin {
    color: #0a66c2;
  }

  .connect-item:is(:hover, :focus-visible) .connect-icon {
    border-color: var(--accent);
    color: var(--accent);
  }

  .connect-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .connect-name {
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .connect-item:is(:hover, :focus-visible) .connect-handle {
    color: var(--text);
  }

  .connect-handle {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.2;
  }
</style>
