---
// One button, three states: System (follows the OS) -> Dark -> Light.
// Light is Warm Paper, dark is Scholar Night (see global.css).
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const names = { system: t('theme.system'), dark: t('theme.dark'), light: t('theme.light') };
const initial = `${t('theme.label')}: ${names.system}`;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label={t('theme.label')}
  data-names={JSON.stringify(names)}
  aria-label={initial}
  title={initial}
>
  <Icon name="monitor" size={16} class="theme-icon icon-system" />
  <Icon name="moon" size={16} class="theme-icon icon-dark" />
  <Icon name="sun" size={16} class="theme-icon icon-light" />
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--control);
    height: var(--control);
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    background-color: var(--bg-subtle);
    color: var(--text);
  }

  .theme-toggle :global(.theme-icon) {
    display: none;
    grid-area: 1 / 1;
  }

  /* The <head> script sets data-theme-pref before paint, so the right icon
     shows immediately instead of swapping once this component's script runs. */
  :global(html:not([data-theme-pref='dark'], [data-theme-pref='light'])) .theme-toggle :global(.icon-system),
  :global([data-theme-pref='dark']) .theme-toggle :global(.icon-dark),
  :global([data-theme-pref='light']) .theme-toggle :global(.icon-light) {
    display: block;
  }

  .theme-toggle.is-switching :global(.theme-icon) {
    animation: theme-icon-in 320ms var(--ease);
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.6);
    }
  }
</style>

<script>
  const order = ['system', 'dark', 'light'] as const;
  type Mode = (typeof order)[number];

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const names = JSON.parse(button.dataset.names!) as Record<Mode, string>;

  const label = (mode: Mode) => {
    const text = `${button.dataset.label}: ${names[mode]}`;
    button.setAttribute('aria-label', text);
    button.title = text;
  };

  let mode: Mode = order.find((m) => m === root.dataset.themePref) ?? 'system';
  label(mode);

  button.addEventListener('click', () => {
    mode = order[(order.indexOf(mode) + 1) % order.length];
    // System drops the attribute so light-dark() follows the OS live.
    if (mode === 'system') delete root.dataset.theme;
    else root.dataset.theme = mode;
    root.dataset.themePref = mode;
    try {
      localStorage.setItem('theme', mode);
    } catch {
      /* storage blocked: the choice lasts for this page view */
    }
    label(mode);
    button.classList.remove('is-switching');
    void button.offsetWidth; // restart the icon animation
    button.classList.add('is-switching');
  });
</script>
