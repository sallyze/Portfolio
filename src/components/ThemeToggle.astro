---
// Two-state theme toggle: Light <-> Dark (first visit auto-matches OS preference).
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const names = { dark: t('theme.dark'), light: t('theme.light') };
const initial = `${t('theme.label')}: ${names.light}`;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label={t('theme.label')}
  data-names={JSON.stringify(names)}
  aria-label={initial}
  title={initial}
>
  <Icon name="moon" size={16} class="theme-icon icon-dark" />
  <Icon name="sun" size={16} class="theme-icon icon-light" />
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--control);
    height: var(--control);
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    background-color: var(--bg-subtle);
    color: var(--text);
  }

  .theme-toggle :global(.theme-icon) {
    display: none;
    grid-area: 1 / 1;
  }

  /* The <head> script sets data-theme before paint, so the right icon
     shows immediately instead of swapping once this component's script runs. */
  :global([data-theme='dark']) .theme-toggle :global(.icon-dark),
  :global([data-theme='light']) .theme-toggle :global(.icon-light) {
    display: block;
  }

  .theme-toggle.is-switching :global(.theme-icon) {
    animation: theme-icon-in 320ms var(--ease);
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.6);
    }
  }
</style>

<script>
  type Mode = 'dark' | 'light';

  const root = document.documentElement;
  const current = (): Mode => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  const label = (button: HTMLButtonElement, mode: Mode) => {
    const names = JSON.parse(button.dataset.names!) as Record<Mode, string>;
    const text = `${button.dataset.label}: ${names[mode]}`;
    button.setAttribute('aria-label', text);
    button.title = text;
  };

  // The button is swapped with the page: relabel it on every page load and
  // handle clicks at the document level.
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (button) label(button, current());
  });

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-theme-toggle]');
    if (!button) return;
    const mode: Mode = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = mode;
    try {
      localStorage.setItem('theme', mode);
    } catch {
      /* storage blocked: the choice lasts for this page view */
    }
    label(button, mode);
    button.classList.remove('is-switching');
    void button.offsetWidth; // restart the icon animation
    button.classList.add('is-switching');
  });
</script>
