---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import photo from '../assets/sally.jpeg';
import { contacts, person } from '../data/cv';
import { homePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://sallyze.dev');
const canonical = new URL(homePath[lang], site);
const ogImage = new URL((await getImage({ src: photo, width: 460, height: 460, format: 'jpg' })).src, site);

const [jobTitle] = person.tagline[lang].split(' | ');
const profileUrls = contacts.filter((c) => c.id === 'github' || c.id === 'linkedin').map((c) => c.href);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: new URL('/', site).href,
  image: ogImage.href,
  jobTitle,
  email: 'mailto:sallyze.dev@gmail.com',
  telephone: '+39 340 196 2592',
  address: { '@type': 'PostalAddress', addressLocality: 'Turin', addressCountry: 'IT' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Politecnico di Torino', url: 'https://www.polito.it' },
  sameAs: profileUrls,
  knowsLanguage: ['fa', 'en', 'az', 'it'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="author" content={person.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(homePath.en, site)} />
    <link rel="alternate" hreflang="it" href={new URL(homePath.it, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(homePath.en, site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    <!-- Runs before first paint so a stored choice never flashes. "system"
         leaves data-theme unset and light-dark() follows the OS. The client
         router replaces <html>'s attributes on every page swap, so the same
         choice is stamped onto each incoming page before it is swapped in. -->
    <script is:inline>
      (() => {
        const apply = (root) => {
          let pref = 'system';
          try {
            const stored = localStorage.getItem('theme');
            if (stored === 'dark' || stored === 'light') pref = stored;
          } catch {}
          if (pref === 'system') delete root.dataset.theme;
          else root.dataset.theme = pref;
          root.dataset.themePref = pref;
        };
        apply(document.documentElement);
        document.addEventListener('astro:before-swap', (event) => apply(event.newDocument.documentElement));
      })();
    </script>

    <!-- Switching language swaps the page in place instead of reloading it. -->
    <ClientRouter />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body id="top">
    <a href="#main" class="skip-to-content">{t('skip')}</a>
    <Header lang={lang} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
  </body>
</html>

<style>
  main {
    flex: 1;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }
</style>
